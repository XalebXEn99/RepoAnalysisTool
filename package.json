{
  "name": "repo-analysis-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RAT - a local web dashboard that measures file, directory, repository, commit-set and author metrics of git repositories (COMS3011A).",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -n server,worker,web -c blue,yellow,green \"npm:dev:server\" \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:worker": "tsx watch src/server/worker.ts",
    "dev:web": "vite",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json --noEmit && esbuild src/server/index.ts src/server/worker.ts src/server/db/migrate.ts --bundle --platform=node --format=esm --packages=external --outdir=dist/server --out-extension:.js=.mjs",
    "build:web": "vite build",
    "start": "node dist/server/index.mjs",
    "worker": "node dist/server/worker.mjs",
    "migrate": "tsx src/server/db/migrate.ts",
    "migrate:production": "node dist/server/db/migrate.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@neon/config": "^1.11.3",
    "@neon/env": "^1.6.15",
    "@neondatabase/serverless": "^1.0.2",
    "dotenv": "^17.2.0",
    "express": "^4.19.2",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "ws": "^8.18.0",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.12.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^9.0.1",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
