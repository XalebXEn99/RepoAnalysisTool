DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
RAT_APP_ORIGIN=http://localhost:5173
RAT_MAX_REPOSITORIES=10
RAT_MAX_UPLOAD_MB=100
RAT_MAX_EXTRACT_MB=1024
RAT_GIT_TIMEOUT_SECONDS=600
RAT_ALLOWED_GIT_HOSTS=github.com,gitlab.com,bitbucket.org
# Optional Neon-only transports for networks blocking PostgreSQL TCP:
# RAT_DATABASE_TRANSPORT=http
# HTTP handles stateless application queries; migrations still require direct TCP.
# WebSocket supports sessions, but requires outbound WebSocket connectivity:
# RAT_DATABASE_TRANSPORT=websocket
